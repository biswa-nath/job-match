{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "alwaysThinkingEnabled": true,
  "showTurnDuration": true,
  "autoUpdatesChannel": "stable",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(src/**)",
      "Edit(src/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(pytest *)"
    ],
    "ask": [
      "Bash(sudo *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "attribution": {
    "commit": "",
    "PR": ""
  }
}
